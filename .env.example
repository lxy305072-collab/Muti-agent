# ==========================================
# 环境变量模板
# 使用方式：cp .env.example .env，然后填入真实值
# ⚠️ 切勿把填好真实密钥的 .env 提交到 Git 仓库
#    （.env 已在 .gitignore 中，.env.example 才是入库的模板）
# ==========================================

# ---------- 阿里云百炼（DashScope）----------
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 模型配置 ----------
# 文案生成与策略分析（researcher / copywriter / critic / channel_adapter）
MODEL_COPYWRITER=qwen-plus
# 绘图提示词重写（prompt_rewriter）
MODEL_PROMPT_REWRITER=qwen-turbo
# 图文一致性审查（visual_reviewer）
MODEL_VISION=qwen-vl-plus
# 配图生成。qwen-image-* 与 wanx* 走不同 DashScope 端点，代码已按前缀自动适配
MODEL_IMAGE=qwen-image-3.0

# ---------- Redis ----------
# 需与 docker-compose.yml 中 redis 容器的 requirepass 保持一致
# 该值同时用于拼接 REDIS_URL，无需再单独配置 REDIS_URL
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ---------- PostgreSQL ----------
# 需与 docker-compose.yml 中 postgres 容器的用户名/密码/库名保持一致
# 首次启动时 init.sql 会自动建表并启用 vector 扩展
# ⚠️ PostgreSQL 仅在数据目录为空（首次初始化）时应用 POSTGRES_PASSWORD。
#    若 ./data/pgdata 已存在，改这里的密码不会自动生效，需手动执行：
#    ALTER USER myuser WITH PASSWORD '新密码';
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=marketing_db
# POSTGRES_URI 由上面几项自动拼接，一般无需填写。
# 若需要连远程库或用特殊参数，可直接写完整连接串覆盖：
# POSTGRES_URI=postgresql://myuser:your_postgres_password@127.0.0.1:5432/marketing_db
